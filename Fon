-- [[ 4. ลูปฟังก์ชันโจมตีและเร่งความเร็ว (Fast Attack Loop) ]] --
task.spawn(function()
    while true do
        if (_G.AutoFarm or _G.FastAttack) then
            pcall(function()
                local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    VU:CaptureController()
                    VU:ClickButton1(Vector2.new(850, 520))
                end
            end)
        end
        task.wait(math.max(0.01, _G.AttackDelay))
    end
end)

-- [[ 5. ลูปฟังก์ชันดึงมอนสเตอร์ (Bring Mob Loop) ]] --
task.spawn(function()
    while true do
        if _G.BringMob then
            pcall(function()
                local pPos = LP.Character.HumanoidRootPart.Position
                for _, m in pairs(workspace.Enemies:GetChildren()) do
                    if m:FindFirstChild("HumanoidRootPart") and (m.HumanoidRootPart.Position - pPos).Magnitude < 250 then
                        m.HumanoidRootPart.CFrame = LP.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                        if m:FindFirstChild("Humanoid") then m.Humanoid.PlatformStand = true end
                    end
                end
            end)
        end
        task.wait(0.3)
    end
end)

