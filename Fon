-- [[ 2. ฟังก์ชันสร้างปุ่มเปิด/ปิด (ไฟเขียว 🟢 / ไฟแดง 🔴) ]] --
local function createToggle(text, pos, varName)
    local Btn = Instance.new("TextButton", Frame)
    Btn.Size = UDim2.new(0, 360, 0, 40)
    Btn.Position = pos
    Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Btn.Text = text .. " (🔴 ปิด)"
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 15
    Btn.Font = Enum.Font.SourceSansBold
    
    local Corner = Instance.new("UICorner", Btn)
    Corner.CornerRadius = UDim.new(0, 6)
    
    Btn.MouseButton1Click:Connect(function()
        _G[varName] = not _G[varName]
        if _G[varName] then
            Btn.Text = text .. " (🟢 เปิด)"
            Btn.BackgroundColor3 = Color3.fromRGB(35, 45, 35)
        else
            Btn.Text = text .. " (🔴 ปิด)"
            Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        end
    end)
end

createToggle("ออโต้คลิก / ฟาร์มเลเวล", UDim2.new(0, 20, 0, 55), "AutoFarm")
createToggle("ดึงมอนสเตอร์มารวมกัน", UDim2.new(0, 20, 0, 105), "BringMob")
